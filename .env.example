APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=templatr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@creative-market.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# Payment Gateways
# ----------------------------------------------------------------------

# Paystack (Nigeria)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MERCHANT_EMAIL=
# Set to '1' for live mode, '0' for test mode
PAYSTACK_LIVE_MODE=0

# Flutterwave (Pan-Africa)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
# Set to '0' for sandbox, '1' for live
FLUTTERWAVE_LIVE_MODE=0

# Interswitch (Nigeria)
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_TERMINAL_ID=
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
# Sandbox: https://sandbox.interswitch.co.ke / Live: https://api.interswitch.co.ke
INTERSWITCH_BASE_URL=https://sandbox.interswitch.co.ke
INTERSWITCH_LIVE_MODE=0

# MTN MoMo (Africa)
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
MOMO_ENVIRONMENT=sandbox
MOMO_COLLECTIONS_PRIMARY_KEY=
MOMO_COLLECTIONS_SECONDARY_KEY=

# ----------------------------------------------------------------------
# Search (Laravel Scout)
# ----------------------------------------------------------------------
# Options: algolia, meilisearch, database, collection, null
SCOUT_DRIVER=database

# Algolia
ALGOLIA_APP_ID=
ALGOLIA_SECRET=

# Meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ----------------------------------------------------------------------
# File Storage (AWS S3 / DigitalOcean Spaces)
# ----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"